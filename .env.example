NODE_ENV=development
PORT=3000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tc_db_dev
POSTGRES_TEST_DB=tc_db_test
POSTGRES_PROD_DB=tc_db_prod
POSTGRES_HOST=localhost
POSTGRES_PORT=5432


# Azure configs
POSTGRES_SSL=false
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
POSTGRES_POOL_MAX=10
JWT_SECRET=replace-with-at-least-24-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
CORS_ORIGIN=http://localhost:5173
MAX_UPLOAD_BYTES=5242880
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_ATTEMPTS=20
SLA_CRITICAL_HOURS=24
SLA_HIGH_HOURS=72
SLA_MEDIUM_HOURS=168
SLA_LOW_HOURS=360

# I will not use azure blobs storage for this, i will only mount the uploads folder
UPLOAD_DIRECTORY=uploads
MANAGER_NAME=Resolve Aí Manager
MANAGER_EMAIL=manager@resolveai.local
MANAGER_PASSWORD=replace-this-password
